// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support enums, so we use String with comments
// Valid values for condition: "switching" | "non_switching"
// Valid values for eventType: "play" | "pause" | "switch" | "complete"

model User {
  id            String         @id @default(uuid())
  participantId String         @unique
  condition     String         // "switching" or "non_switching"
  videoSet      String         @default("A") // "A" or "B"
  trainingType  String         @default("full") // "short" (one phase) or "full" (three phases)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      VideoSession[]
  gazeSamples   GazeSample[]
  phaseLogs     PhaseLog[]

  @@map("users")
}

// Start/end of each stage of the study: the EEG baseline video, training, and
// the experiment block. A row with endedAt = null means the participant left
// that stage without finishing it.
// Valid values for phase: "eeg_baseline" | "training" | "experiment" | "recording"
model PhaseLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phase         String
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  @@map("phase_logs")
}

model GazeSample {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String   @default("") // video being watched, "" if none
  x         Float
  y         Float
  timestamp Float    // WebGazer clock: ms since begin(), resets per page load
  // Wall clock on the participant's machine when the sample was captured. The
  // WebGazer clock has no epoch, so this is what aligns gaze to video events
  // and to the screen recording.
  clientTime DateTime?
  createdAt DateTime @default(now())

  @@map("gaze_samples")
}

model VideoSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String
  mode        String        // "switching" or "non_switching"
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  events      VideoEvent[]

  @@map("video_sessions")
}

model VideoEvent {
  id        String    @id @default(uuid())
  sessionId String
  session   VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String    // "play" | "pause" | "switch" | "complete"
  timestamp DateTime  @default(now())
  duration  Float?    // Duration in seconds (for pause events)
  fromVideoId String? // For switch events
  toVideoId   String? // For switch events
  playbackPosition Float? // Position in video when event occurred

  @@map("video_events")
}
