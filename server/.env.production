# Backend Production Environment
# Copy this to .env for production deployment

# Database - SQLite (file-based database)
DATABASE_URL="file:./prisma/video_switching.db"

# Server
PORT=5001
NODE_ENV=production

# JWT - CHANGE THIS to a secure secret key in production
JWT_SECRET=video_switching_research_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS - Allow requests from production frontend
# If using port 3000 directly: CLIENT_URL=http://codes.cs.vt.edu:3000
# If using reverse proxy on port 80: CLIENT_URL=http://codes.cs.vt.edu
CLIENT_URL=http://codes.cs.vt.edu:3000
